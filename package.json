{
  "name": "yiyin",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "A local desktop photo framing and metadata tool",
  "author": {
    "name": "ggchivalrous",
    "url": "https://github.com/ggchivalrous/yiyin"
  },
  "license": "GPL-3.0-only",
  "repository": "https://github.com/ggchivalrous/yiyin",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "dev": "vite",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "build": "vite build",
    "tauri": "tauri",
    "audit": "pnpm audit --audit-level high",
    "check:release-age": "node scripts/check-release-age.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "smoke:w3c": "node scripts/w3c-smoke.mjs",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
