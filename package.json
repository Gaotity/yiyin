{
  "name": "yiyin",
  "type": "module",
  "version": "1.6.0",
  "packageManager": "pnpm@11.13.0",
  "description": "A desktop photo watermarking tool",
  "author": {
    "name": "Gaotity",
    "url": "https://github.com/Gaotity"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaotity/yiyin.git"
  },
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "dev": "pnpm electron:install && vite",
    "electron:install": "install-electron",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm electron:install && pnpm build && playwright test",
    "build": "vite build",
    "package": "pnpm build && electron-builder --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm audit --prod --audit-level high && pnpm build"
  },
  "dependencies": {
    "exifreader": "4.41.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.1.1",
    "@electron/fuses": "2.1.3",
    "@ggchivalrous/db-ui": "1.3.1",
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "3.1.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.2.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-svelte": "3.17.0",
    "sass": "^1.93.0",
    "svelte": "4.2.20",
    "svelte-check": "^4.3.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-electron": "0.29.0",
    "vitest": "3.2.4"
  },
  "build": {
    "asar": true,
    "appId": "io.github.gaotity.yiyin",
    "productName": "壹印",
    "copyright": "Copyright © 2026 Gaotity",
    "artifactName": "yiyin-${version}-${platform}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.mjs",
    "extraMetadata": {
      "main": "./main/index.js",
      "type": "module"
    },
    "files": [
      {
        "from": "dist-electron",
        "to": ".",
        "filter": [
          "**/*",
          "!package.json"
        ]
      },
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "identity": null,
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
